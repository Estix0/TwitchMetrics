# Ścieżka do bazy danych SQLite (wewnątrz kontenera: /data/messages.db, lokalnie: messages.db)
DB_FILE=/data/messages.db

# Dane aplikacji z Twitch Developer Console (dev.twitch.tv)
CLIENT_ID=""
